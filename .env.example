NODE_ENV=development
API_PORT=3001
DB_PATH=server/data/bookstore.sqlite
# Set a random value of at least 32 characters before production deployment.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
# Optional Razorpay API keys. When both are blank, PhonePe QR manual verification is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure a Razorpay webhook for payment.captured and payment.failed.
RAZORPAY_WEBHOOK_SECRET=
# Private /admin dashboard credentials (password must be stored as a bcrypt hash).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# SMTP settings required for customer OTP and order-status emails.
# Use a verified sender and an app password or provider SMTP key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Shiprocket API credentials (keep private; configure pickup/package dimensions too).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Optional HTTPS API base if Shiprocket has provisioned a separate sandbox endpoint for your account.
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PACKAGE_LENGTH_CM=
SHIPROCKET_PACKAGE_BREADTH_CM=
SHIPROCKET_PACKAGE_HEIGHT_CM=
SHIPROCKET_PACKAGE_WEIGHT_KG=
# Optional Shiprocket courier ID. Leave empty to use Shiprocket's available assignment.
SHIPROCKET_COURIER_ID=
